generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  role      Role       @default(CLIENT)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  professionalProfile ProfessionalProfile?
  clientProfile       ClientProfile?

  sentMessages  Message[]      @relation("SentMessages")
  notifications Notification[]
  auditLogs     AuditLog[]
}

model ProfessionalProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  bio              String?
  specialty        String?
  experienceYears  Int?
  location         String?
  avatarUrl        String?
  isActive         Boolean          @default(true)
  availabilityMode AvailabilityMode @default(OPEN_HOURS)
  bookingFlowMode  BookingFlowMode  @default(PROFESSIONAL_FIRST)
  averageRating    Float            @default(0)
  reviewCount      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  services               Service[]
  resources              Resource[]
  availability           Availability[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  conversations          Conversation[]
  reviews                Review[]                @relation("ProfessionalReviews")
  calendarBlocks         CalendarBlock[]

  @@index([isActive])
  @@index([location])
  @@index([specialty])
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments  Appointment[]
  conversations Conversation[]
  reviews       Review[]       @relation("ClientReviews")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
}

model Service {
  id              String          @id @default(uuid())
  professionalId  String
  categoryId      String?
  title           String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  durationMinutes Int
  modality        ServiceModality @default(IN_PERSON)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  appointments     Appointment[]
  resourceServices ResourceService[]

  @@index([professionalId])
  @@index([categoryId])
  @@index([isActive])
}

model Resource {
  id             String       @id @default(uuid())
  professionalId String
  name           String
  type           ResourceType @default(PERSON)
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  services       ResourceService[]
  calendarBlocks CalendarBlock[]
  availability   ResourceAvailability[]
  appointments   Appointment[]

  @@index([professionalId])
  @@index([isActive])
  @@index([type])
}

model ResourceService {
  id         String   @id @default(uuid())
  resourceId String
  serviceId  String
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, serviceId])
  @@index([resourceId])
  @@index([serviceId])
}

model Availability {
  id             String   @id @default(uuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([dayOfWeek])
}

model AvailabilityException {
  id             String                    @id @default(uuid())
  professionalId String
  date           DateTime
  type           AvailabilityExceptionType
  startTime      String?
  endTime        String?
  reason         String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date])
  @@index([professionalId])
  @@index([date])
  @@index([type])
}

model ResourceAvailability {
  id         String   @id @default(uuid())
  resourceId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([dayOfWeek])
}

model CalendarBlock {
  id String @id @default(uuid())

  professionalId String
  resourceId     String?

  startDateTime DateTime
  endDateTime   DateTime

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([professionalId])
  @@index([resourceId])
  @@index([startDateTime])
  @@index([endDateTime])
}

model Appointment {
  id             String            @id @default(uuid())
  clientId       String
  professionalId String
  resourceId     String?
  serviceId      String
  date           DateTime
  startTime      String
  endTime        String
  status         AppointmentStatus @default(REQUESTED)
  notes          String?
  statusReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  resource     Resource?           @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  conversation Conversation?
  reviews      Review[]

  @@index([clientId])
  @@index([professionalId])
  @@index([resourceId])
  @@index([serviceId])
  @@index([status])
  @@index([date])
}

model Conversation {
  id             String   @id @default(uuid())
  clientId       String
  professionalId String
  appointmentId  String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([clientId])
  @@index([professionalId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Review {
  id String @id @default(uuid())

  appointmentId  String @unique
  clientId       String
  professionalId String

  rating  Int
  comment String

  professionalReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment  Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       ClientProfile       @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("ProfessionalReviews", fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([clientId])
  @@index([rating])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  content    String?
  actionUrl  String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([type])
  @@index([entityType])
  @@index([entityId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  PROFESSIONAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ServiceModality {
  ONLINE
  IN_PERSON
  HYBRID
}

enum AppointmentStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_PROFESSIONAL
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum ReviewStatus {
  PENDING
  VISIBLE
  HIDDEN
}

enum AvailabilityExceptionType {
  UNAVAILABLE
  CUSTOM_HOURS
}

enum AvailabilityMode {
  OPEN_HOURS
  FIXED_SLOTS
}

enum ResourceType {
  PERSON
  ROOM
  CHAIR
  EQUIPMENT
  OTHER
}

enum BookingFlowMode {
  PROFESSIONAL_FIRST
  SERVICE_FIRST
  RESOURCE_FIRST
  AUTO_ASSIGN
}
